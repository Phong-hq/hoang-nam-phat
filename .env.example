NUXT_PUBLIC_SITE_URL=https://hoangnamphat.vn
NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_ERP_API_BASE_URL=http://localhost:9001/
NUXT_API_SECRET=
# Dev server bind host -- defaults to 127.0.0.1 to avoid IPv6 (::1) sitemap URL bugs
NUXT_HOST=127.0.0.1

# Đo lường (để trống = không nạp). Dùng GTM thì cấu hình GA4 + Pixel bên trong GTM và
# để trống 2 biến dưới; chỉ dùng GA4_ID khi KHÔNG có GTM (gắn cả hai sẽ đếm trùng).
NUXT_PUBLIC_GTM_ID=
NUXT_PUBLIC_GA4_ID=
NUXT_PUBLIC_FB_PIXEL_ID=
# true trên bản staging/test -> mọi trang gắn noindex, Google không index trùng site thật
NUXT_PUBLIC_NO_INDEX=
